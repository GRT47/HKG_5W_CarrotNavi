{
  "id": "carrotbridge-panel",
  "name": "CarrotNavi 분할화면 · 앱 메뉴 · WiFi+LTE 공존",
  "version": "1.2.1",
  "hmgapi": ">=1.0.0",
  "authors": ["GRT47"],
  "license": "MIT",
  "repo": "https://github.com/GRT47/HKG_5W_CarrotNavi",
  "description": "HKG 5W CarrotNavi를 순정 전체 앱 메뉴와 사용자 버튼(★)에 추가하고, 연결 상태 위젯을 우측 분할화면 페이지로 표시하며 WiFi(Client) 연결 시에도 순정 LTE 기본 회선을 유지합니다.",
  "live": false,
  "hooks": {
    "jar": "hooks.jar",
    "entry": "com.hkg.carrotbridge.hook.CarrotWifiLteHook"
  },
  "apps": [
    {
      "apk": "app/CarrotPanel.apk",
      "package": "com.hkg.carrotbridge.panel"
    }
  ],
  "provides": {
    "launcher": [
      {
        "id": "carrotnavi",
        "title": "CarrotNavi",
        "package": "com.hkg.carrotbridge.panel",
        "class": ".OpenDashboardActivity",
        "icon": "icons/icon.png",
        "icon_night": "icons/icon_night.png",
        "icon_disabled": "icons/icon_disabled.png",
        "icon_disabled_night": "icons/icon_disabled_night.png"
      }
    ],
    "star_key": [
      {
        "id": "open",
        "title": "CarrotNavi",
        "activity": {
          "package": "com.hkg.carrotbridge.panel",
          "class": ".OpenDashboardActivity"
        }
      }
    ],
    "panel": [
      {
        "title": "CarrotNavi",
        "widget": "com.hkg.carrotbridge.panel/.CarrotPanelWidget"
      }
    ]
  }
}
